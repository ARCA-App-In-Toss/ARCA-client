{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!.claude", "!design", "!src/data/api/generated", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/screens/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/services*", "**/app/composition*"],
                    "message": "화면은 app/hooks의 요약값과 좁은 행동만 사용합니다."
                  },
                  {
                    "group": ["@apps-in-toss/*", "**/platform/**", "**/domain/ports/**"],
                    "message": "화면은 플랫폼 SDK·포트를 직접 다루지 않습니다."
                  },
                  {
                    "group": ["**/data/**"],
                    "message": "화면은 wire DTO·HTTP·Storage를 직접 다루지 않습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/domain/**", "!src/domain/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/**", "**/screens/**", "**/ui/**", "**/data/**", "**/platform/**", "**/mocks/**"],
                    "message": "domain은 바깥 계층을 모릅니다. 필요한 기능은 domain/ports에 인터페이스로 정의합니다."
                  },
                  {
                    "group": ["react", "react-dom", "@tanstack/*", "@apps-in-toss/*", "react-router"],
                    "message": "domain은 UI·프레임워크·SDK에 의존하지 않습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/data/**", "!src/data/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/**", "**/screens/**", "**/ui/**", "**/platform/**", "**/mocks/**"],
                    "message": "data는 domain 포트를 구현할 뿐 바깥 계층을 모릅니다."
                  },
                  {
                    "group": ["react", "react-dom", "react-router", "@apps-in-toss/*"],
                    "message": "data는 UI·SDK에 의존하지 않습니다."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/app/**", "**/screens/**", "**/ui/**", "**/data/**", "**/mocks/**"],
                    "message": "platform은 domain 포트를 구현할 뿐 다른 계층을 모릅니다."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
